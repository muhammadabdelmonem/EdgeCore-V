*.cache/
*.hw/
*.sim/
*.ip_user_files/
*.runs/
  synth_1/
  impl_1/
  
# Vivado temporary files
*.tmp
*.debug

# Checkpoint files
*.dcp

# Journal and log files
*.jou
*.log

